# --- Required ---
# Your bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-bot-token-here
# The single Discord server (guild) this bot should monitor.
TARGET_GUILD_ID=000000000000000000
# The channel ID where suspicious messages are sent for human review.
MOD_CHANNEL_ID=000000000000000000

# --- Optional (defaults shown) ---
# When true, the bot only logs what it *would* do instead of deleting/timing out.
SHADOW_MODE=true
# A new joiner becomes trusted (and stops being monitored) after this many
# clean messages. Trust is activity-based, not time-based.
GRADUATION_MESSAGE_COUNT=5

# Score thresholds that decide the moderation action.
REVIEW_THRESHOLD=4
DELETE_THRESHOLD=8
TIMEOUT_THRESHOLD=12
TIMEOUT_MINUTES=10

# Fuzzy-match cutoff against the learned spam database (0.0 - 1.0).
KNOWN_SPAM_SIMILARITY=0.85
# Skip adding a newly learned template if it is too similar to an existing one.
NEAR_DUPLICATE_SIMILARITY=0.98

# Cross-channel burst detection (exact duplicates).
# Same message in >= BURST_CHANNELS channels within BURST_WINDOW_SECONDS -> action.
BURST_CHANNELS=3
BURST_WINDOW_SECONDS=60
TRACKER_RETENTION_SECONDS=120
REPEAT_COUNT=2

# Where the SQLite database lives.
DB_PATH=moderation.db
# Sentence-transformers model used for embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Command prefix reserved by discord.py (no text commands are used currently).
COMMAND_PREFIX=!
